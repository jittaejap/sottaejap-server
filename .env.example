# 로컬 실행용 환경 변수 예시. 값의 정본은 sottaejap-docs/07_기술스택_레포구성.md §3.
# 사용: cp .env.example .env   (Windows: Copy-Item .env.example .env)
# docker compose 는 이 폴더의 .env 를 자동으로 읽어 ${KEY} 자리를 채운다. .env 가 없어도 로컬 잠정값으로 뜬다.
# 컨테이너 안에서 쓰는 주소(db:5432 · ai:8000)는 docker-compose.yml 이 직접 넘긴다 — 아래 localhost 값은 컨테이너 밖에서 직접 띄울 때 쓴다.
# .env는 커밋하지 않는다. application.yml이 spring.config.import로 이 파일을 properties로 읽는다.
# 주의: properties 형식이라 줄 끝 주석(KEY=값  # 설명)은 값에 포함된다. 주석은 반드시 별도 줄에 쓴다.

SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/sottaejap
DB_USER=sottaejap
DB_PASSWORD=sottaejap

AI_BASE_URL=http://localhost:8000
# X-Internal-Secret — sottaejap-ai의 INTERNAL_SHARED_SECRET과 같은 값 (05 §3). 비우면 /internal/ai/*가 전부 401.
AI_SHARED_SECRET=
# Spring → AI /chat 타임아웃(ms). 잠정 — AI 내부의 LLM 6초(재시도 1회 포함 최악 12초) + Spring 조회 왕복 포함 (05 §3 · E-88)
AI_TIMEOUT_MS=15000

# AI 컨테이너로 넘어가는 값 (sottaejap-ai 의 OPENAI_API_KEY). 비우면 템플릿 응답 + fallback: true 로 200 이다 (E-38).
# docker compose 로 ai 를 함께 띄울 때만 쓰인다.
OPENAI_API_KEY=

# 카카오 로그인 (01 E-55). 흐름: 클라이언트가 인가 코드를 받아 POST /auth/login으로 넘기고 서버가 교환한다.
# KAKAO_CLIENT_ID = REST API 키. KAKAO_CLIENT_SECRET은 서버에만 둔다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 허용할 클라이언트 콜백 URL. 쉼표로 구분한다. 카카오 콘솔의 리다이렉트 URI와 같은 값이어야 한다 (07 §3).
KAKAO_REDIRECT_URIS=http://localhost:5173/auth/callback
# CORS 허용 출처, 쉼표 구분. 배포 환경에서는 클라이언트(Vercel) 주소를 넣는다 (07 §3).
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# Base64로 인코딩한 32바이트 이상 키. 생성: openssl rand -base64 48
JWT_SECRET=

# 규칙 파라미터 덮어쓰기 (07 §7 · E-57). 덮어쓸 때만 키를 추가한다. 예: RULES_SHRINKAGE_K=5 · RULES_CANDIDATE_BIG_AMOUNT_BUDGET_RATIO=0.05
# 값을 비우지 말고 키를 지운다 — `RULES_SHRINKAGE_K=`는 잠정값이 아니라 null이다. ${RULES_X:잠정값}은 키가 아예 없을 때만 잠정값을 준다.
# 값을 비우면 숫자 키는 회고 저장 첫 요청에서 RuleParamMissingException(500)으로, RULES_CLUSTER_MEAL_CATEGORIES는 빈 목록이라 기동 시가 아니라 규칙 안에서 같은 예외로 드러난다.

# 알림 · Web Push (FR-10 · E-71 · 07 §3). 키 생성 절차는 README "Web Push 키 설정"에 있다.
# 세 값을 다 채워야 푸시가 켜진다. 비워 두면 푸시만 꺼지고 인앱 알림은 그대로 동작한다.
# 형식이 틀리면 기동이 실패한다 — 조용히 꺼두면 원인을 찾느라 시간을 쓰기 때문이다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 곳. mailto: 또는 https URL이어야 한다. 예: mailto:team@sottaejap.kr
VAPID_SUBJECT=
# 회고 요청 알림 스캔 주기 (Asia/Seoul). 알림 시각은 30분 격자에 내린 값이므로(E-71) 주기도 30분 격자에 맞춘다.
# 시간마다(0 0 * * * *)로 바꾸면 목표 시각이 :30인 사용자는 스케줄에 영영 걸리지 않고 목록 조회 경로만 남는다.
NOTIFICATION_DAILY_CRON=0 0,30 * * * *

# 데모 계정 폴백 (E-15)
DEMO_ACCOUNT_ENABLED=true
