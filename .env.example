# 로컬 실행용 환경 변수 예시. 값의 정본은 sottaejap-docs/07_기술스택_레포구성.md §3.
# 사용: cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env는 커밋하지 않는다. application.yml이 spring.config.import로 이 파일을 properties로 읽는다.
# 주의: properties 형식이라 줄 끝 주석(KEY=값  # 설명)은 값에 포함된다. 주석은 반드시 별도 줄에 쓴다.

SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/sottaejap
DB_USER=sottaejap
DB_PASSWORD=sottaejap

AI_BASE_URL=http://localhost:8000
# X-Internal-Secret — sottaejap-ai의 INTERNAL_SHARED_SECRET과 같은 값 (05 §3). 비우면 /internal/ai/*가 전부 401.
AI_SHARED_SECRET=
# Spring → AI /chat 타임아웃(ms). 잠정 — AI 내부의 LLM 8초 + Spring 조회 왕복 포함 (05 §3)
AI_TIMEOUT_MS=15000

# 카카오 로그인 (01 E-55). 흐름: 클라이언트가 인가 코드를 받아 POST /auth/login으로 넘기고 서버가 교환한다.
# KAKAO_CLIENT_ID = REST API 키. KAKAO_CLIENT_SECRET은 서버에만 둔다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 허용할 클라이언트 콜백 URL. 쉼표로 구분한다. 카카오 콘솔의 리다이렉트 URI와 같은 값이어야 한다 (07 §3).
KAKAO_REDIRECT_URIS=http://localhost:5173/auth/callback
# Base64로 인코딩한 32바이트 이상 키. 생성: openssl rand -base64 48
JWT_SECRET=

# 규칙 파라미터 덮어쓰기 (07 §7 · E-57). 비우면 application.yml 잠정값. 예: RULES_SHRINKAGE_K=5 · RULES_CANDIDATE_BIG_AMOUNT_BUDGET_RATIO=0.05
# 데모 계정 폴백 (E-15)
DEMO_ACCOUNT_ENABLED=true
